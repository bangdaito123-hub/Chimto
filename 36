-- ===== ESP & AIMBOT CACHE =====
local ESP_Cache = {}
local CurrentTarget = nil
local FOVCircle = nil

local function createFOVCircle()
    if FOVCircle then return end
    FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 1.5
    FOVCircle.Color = Color3.fromRGB(0, 255, 0)
    FOVCircle.Filled = false
    FOVCircle.Radius = getgenv().CameraLockFOV
    FOVCircle.Visible = false
end
createFOVCircle()

RS.RenderStepped:Connect(function()
    -- Cập nhật FOV Circle
    if getgenv().CameraLock then
        FOVCircle.Visible = true
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = getgenv().CameraLockFOV
    else
        FOVCircle.Visible = false
    end

    local target, dist = nil, math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= LP and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and
           v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then

            local aimPart = v.Character:FindFirstChild(getgenv().AimPart)

            -- ESP
            if not ESP_Cache[v] then
                ESP_Cache[v] = Instance.new("Highlight")
            end
            local hl = ESP_Cache[v]
            hl.Parent = getgenv().ESP_Highlight and v.Character or nil
            if getgenv().ESP_Highlight then
                hl.FillColor = Color3.new(1, 0, 0)
                hl.OutlineColor = Color3.new(1, 1, 1)
            end

            -- Aimbot + Camera Lock
            if (getgenv().Aimbot or getgenv().CameraLock) and aimPart then
                local pos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                if onScreen and IsVisible(aimPart) then
                    local mag = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    local fovLimit = getgenv().CameraLock and getgenv().CameraLockFOV or 360
                    if mag < fovLimit and mag < dist then
                        target = v
                        dist = mag
                    end
                end
            end
        else
            if ESP_Cache[v] then
                ESP_Cache[v].Parent = nil
            end
        end
    end

    CurrentTarget = target

    -- Aimbot
    if getgenv().Aimbot and target and target.Character:FindFirstChild(getgenv().AimPart) then
        local lookAt = CFrame.new(Camera.CFrame.Position, target.Character[getgenv().AimPart].Position)
        Camera.CFrame = Camera.CFrame:Lerp(lookAt, getgenv().Smoothness)
    end

    -- Camera Lock
    if getgenv().CameraLock and target and target.Character:FindFirstChild(getgenv().AimPart) then
        local lookAt = CFrame.new(Camera.CFrame.Position, target.Character[getgenv().AimPart].Position)
        Camera.CFrame = Camera.CFrame:Lerp(lookAt, getgenv().CameraLockSmoothness)
    end
end)

game.Players.PlayerRemoving:Connect(function(p)
    if ESP_Cache[p] then
        ESP_Cache[p]:Destroy()
        ESP_Cache[p] = nil
    end
end)

