local SettingsTab = Window:CreateTab("Cài Đặt", 4483362458)

SettingsTab:CreateSection("Lưu Script")
SettingsTab:CreateInput({
    Name = "Tên script (để lưu)",
    PlaceholderText = "Ví dụ: Auto Farm",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        if Text and Text ~= "" then
            getgenv().LastScriptName = Text
        end
    end
})
SettingsTab:CreateInput({
    Name = "Link script (raw)",
    PlaceholderText = "https://...",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        if Text and Text ~= "" then
            getgenv().LastScriptLink = Text
        end
    end
})
SettingsTab:CreateButton({
    Name = "📥 Lưu Script",
    Callback = function()
        local name = getgenv().LastScriptName
        local link = getgenv().LastScriptLink
        if name and link then
            getgenv().SavedScripts[name] = link
            Rayfield:Notify({
                Title = "Đã lưu",
                Content = "Script '" .. name .. "' đã được lưu.",
                Duration = 3
            })
        else
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Vui lòng nhập đầy đủ tên và link.",
                Duration = 3
            })
        end
    end
})
SettingsTab:CreateButton({
    Name = "🗑️ Xóa tất cả script đã lưu",
    Callback = function()
        getgenv().SavedScripts = {}
        Rayfield:Notify({
            Title = "Đã xóa",
            Content = "Đã xóa toàn bộ script đã lưu.",
            Duration = 3
        })
    end
})

SettingsTab:CreateSection("Tự động chạy")
SettingsTab:CreateToggle({
    Name = "Bật tự động chạy script đã lưu khi vào game",
    CurrentValue = false,
    Callback = function(v)
        getgenv().AutoRunSavedScripts = v
        if v then
            -- Chạy các script đã lưu ngay lập tức
            for name, link in pairs(getgenv().SavedScripts) do
                if not getgenv().LoadedScripts[name] then
                    pcall(function()
                        loadstring(game:HttpGet(link))()
                        getgenv().LoadedScripts[name] = true
                        print("[Cài Đặt] Đã tự động chạy script: " .. name)
                    end)
                end
            end
        end
    end
})
SettingsTab:CreateButton({
    Name = "▶️ Chạy tất cả script đã lưu (thủ công)",
    Callback = function()
        for name, link in pairs(getgenv().SavedScripts) do
            pcall(function()
                loadstring(game:HttpGet(link))()
                getgenv().LoadedScripts[name] = true
                print("[Cài Đặt] Đã chạy script: " .. name)
            end)
        end
        Rayfield:Notify({
            Title = "Hoàn tất",
            Content = "Đã chạy tất cả script đã lưu.",
            Duration = 3
        })
    end
})

