-- ========== 2. AIMBOT (giữ nguyên bản fix) ==========
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local mouse = LocalPlayer:GetMouse()

local aimEnabled = true
local aimKey = "RightControl"
local fovRadius = 200
local smoothness = 5
local teamCheck = true

local function getClosestEnemy()
    if not aimEnabled then return nil end
    local closest = nil
    local shortest = fovRadius
    local center = Vector2.new(mouse.X, mouse.Y)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = plr.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if teamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
                local root = plr.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToScreenPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                    if dist < shortest then
                        closest = root
                        shortest = dist
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if aimEnabled and UserInputService:IsKeyDown(Enum.KeyCode[aimKey]) then
        local target = getClosestEnemy()
        if target then
            local targetPos = target.Position
            local camPos = Camera.CFrame.Position
            local dir = (targetPos - camPos).unit
            local targetCF = CFrame.new(camPos, camPos + dir)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / smoothness)
        end
    end
end)

-- ========== 3. FLY (thêm mới - mượt mà, bật/tắt bằng phím X) ==========
local flying = false
local bodyVelocity = nil
local bodyGyro = nil
local lc = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local function getChar() return LocalPlayer.Character end

local function startFly()
    local char = getChar()
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    flying = true
    humanoid.PlatformStand = true
    bodyVelocity = Instance.new("BodyVelocity")
    bodyGyro = Instance.new("BodyGyro")
    bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVelocity.Velocity = Vector3.new(0,0,0)
    bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bodyGyro.CFrame = char.HumanoidRootPart.CFrame
    bodyVelocity.Parent = char.HumanoidRootPart
    bodyGyro.Parent = char.HumanoidRootPart
end

local function stopFly()
    flying = false
    local char = getChar()
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.PlatformStand = false
    end
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
end

-- Điều khiển bay bằng phím WASD + Space + Ctrl
local function onFlyUpdate()
    if not flying then return end
    local char = getChar()
    if not char or not char.HumanoidRootPart then
        stopFly()
        return
    end
    local rootPart = char.HumanoidRootPart
    local moveDirection = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Vector3.new(0,0,-1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection + Vector3.new(0,0,1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection + Vector3.new(-1,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Vector3.new(1,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection + Vector3.new(0,-1,0) end
    
    local camCF = workspace.CurrentCamera.CFrame
    local forward = camCF.LookVector
    local right = camCF.RightVector
    local up = camCF.UpVector
    local velocity = (forward * moveDirection.Z + right * moveDirection.X + up * moveDirection.Y) * 50
    if bodyVelocity then bodyVelocity.Velocity = velocity end
    if bodyGyro then bodyGyro.CFrame = camCF end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.X then
        if flying then stopFly() else startFly() end
    end
end)

RunService.Heartbeat:Connect(function()
    if flying then onFlyUpdate() end
end)

