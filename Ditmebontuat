-- Hàm tìm kẻ địch gần nhất (cải tiến)
local function getClosestEnemy()
    if not aimEnabled then return nil end
    local closest = nil
    local shortest = fovRadius
    local center = Vector2.new(mouse.X, mouse.Y)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character.Humanoid.Health > 0 then
            if teamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
            local root = plr.Character.HumanoidRootPart
            local pos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end
            local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
            if dist < shortest then
                if visibleCheck then
                    local ray = Ray.new(Camera.CFrame.Position, (root.Position - Camera.CFrame.Position).unit * 1000)
                    local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
                    if hit and hit:IsDescendantOf(plr.Character) then
                        closest = root
                        shortest = dist
                    end
                else
                    closest = root
                    shortest = dist
                end
            end
        end
    end
    return closest
end

-- Aimbot loop
RunService.RenderStepped:Connect(function()
    if aimEnabled and UserInputService:IsKeyDown(Enum.KeyCode[aimKey]) then
        local target = getClosestEnemy()
        if target then
            local targetPos = target.Position
            local camPos = Camera.CFrame.Position
            local dir = (targetPos - camPos).unit
            local targetCF = CFrame.new(camPos, camPos + dir)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / smoothness)
        end
    end
end)

-- ESP (Box & Tracer) - đơn giản hóa
if espEnabled then
    local function espLoop()
        while espEnabled and task.wait(0.03) do
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local root = plr.Character.HumanoidRootPart
                    local pos, onScreen = Camera:WorldToScreenPoint(root.Position)
                    if onScreen then
                        -- Vẽ box (dùng Drawing nếu có, không thì bỏ qua)
                        if espBox and Drawing then
                            local box = Drawing.new("Square")
                            box.Size = Vector2.new(50, 100)
                            box.Position = Vector2.new(pos.X - 25, pos.Y - 50)
                            box.Color = Color3.new(1,0,0)
                            box.Thickness = 2
                            box.Filled = false
                            box.Visible = true
                            task.wait(0.03)
                            box:Remove()
                        end
                        if espTracer and Drawing then
                            local line = Drawing.new("Line")
                            line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                            line.To = Vector2.new(pos.X, pos.Y)
                            line.Color = Color3.new(0,1,0)
                            line.Thickness = 1
                            line.Visible = true
                            task.wait(0.03)
                            line:Remove()
                        end
                    end
                end
            end
        end
    end
    coroutine.wrap(espLoop)()
end

-- **KILL SERVER** (phá server - nguy hiểm, có thể ban IP)
local function killServer()
    -- Phương pháp 1: Gửi hàng triệu request tới RemoteEvent
    local replicatedFirst = game:GetService("ReplicatedFirst")
    local success, err = pcall(function()
        -- Tạo vòng lặp vô tận tạo part
        for i = 1, 5000 do
            local part = Instance.new("Part")
            part.Size = Vector3.new(10,10,10)
            part.CFrame = CFrame.new(0, 999999, 0)
            part.Anchored = true
            part.Parent = workspace
            part.Name = "CrashPart" .. i
        end
        -- Gửi yêu cầu đồng bộ liên tục
        game:GetService("ReplicatedStorage"):Destroy()
        for _ = 1, 1e6 do
            game:GetService("NetworkClient"):GetApi():SetTelemetryData("crash", {})
        end
    end)
    if not success then
        -- Phương pháp 2: Dùng while true do end trong context của server? Không thể. Nhưng có thể gây lag bằng cách spawn hàng nghìn coroutine
        for _ = 1, 1000 do
            spawn(function()
                while true do end
            end)
        end
    end
end

